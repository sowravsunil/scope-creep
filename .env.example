# Copy this file to .env and paste your keys after the = signs.
# .env is git-ignored. Never commit it or paste the keys anywhere else.
RL_API_KEY=
# OpenRouter key for live evaluations. Enter keys separately in each app's install settings.
OPENROUTER_API_KEY=
# Optional, for seed.py: the Rocketlane user ID to own the demo project (defaults to the first team member)
RL_OWNER_ID=
